# Existing local Prisma database. Keep this value while the old demo seed is still used.
DATABASE_URL="file:./dev.db"

# Supabase project API settings. These two values are safe for the browser.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="YOUR_SUPABASE_PUBLISHABLE_KEY"

# Server-only secrets. Never prefix these values with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"
OWNERSHIP_IMPORT_SECRET="CHOOSE_A_LONG_RANDOM_ADMIN_SECRET"
SUPABASE_DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:PASSWORD@HOST:6543/postgres?pgbouncer=true"
SUPABASE_DIRECT_URL="postgresql://postgres:PASSWORD@HOST:5432/postgres"
