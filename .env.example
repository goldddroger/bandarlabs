# Existing local Prisma database. Keep this value while the old demo seed is still used.
DATABASE_URL="file:./dev.db"

# Supabase project API settings. These two values are safe for the browser.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="YOUR_SUPABASE_PUBLISHABLE_KEY"

# Server-only secrets. Never prefix these values with NEXT_PUBLIC_.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD_HASH="pbkdf2-sha256:ITERATIONS:SALT:HASH"
AUTH_SESSION_SECRET="CHOOSE_A_RANDOM_32_BYTE_SESSION_SECRET"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"
SUPABASE_DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:PASSWORD@HOST:6543/postgres?pgbouncer=true"
SUPABASE_DIRECT_URL="postgresql://postgres:PASSWORD@HOST:5432/postgres"

# Axentraz Broker Activity API. Server-only, never prefix with NEXT_PUBLIC_.
AXENTRAZ_API_KEY="YOUR_AXENTRAZ_API_KEY"
